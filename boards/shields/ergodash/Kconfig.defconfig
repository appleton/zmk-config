if SHIELD_ERGODASH_DONGLE

config ZMK_KEYBOARD_NAME
    default "Ergodash Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Two keyboard halves plus the default five host Bluetooth profiles.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
